{
	"name": "dsh-compat",
	"version": "0.1.1",
	"description": "dsh 插件兼容层：L2 加载器隔离补丁 + L3 客户端垫片（polyfill + 全局 CSS）+ L4 安装门禁 doctor",
	"type": "module",
	"main": "lib/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Starsky16/dsh-compat.git"
	},
	"files": [
		"lib/",
		"css/",
		"bin/",
		"patches/",
		"compat/",
		"cordis.patch.yml",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"engines": {
		"node": ">=24.2"
	},
	"bin": {
		"dsh-compat-doctor": "bin/doctor.mjs",
		"dsh-compat-patch": "bin/patch.mjs",
		"dsh-compat-selfcheck": "bin/selfcheck.mjs"
	},
	"scripts": {
		"doctor": "node bin/doctor.mjs",
		"patch": "node bin/patch.mjs",
		"selfcheck": "node bin/selfcheck.mjs",
		"test": "node --test \"test/*.test.mjs\""
	},
	"license": "MIT"
}
